{
  "name": "copicopi-app",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first reference and drawing workspace",
  "type": "module",
  "scripts": {
    "test:bundle": "node ../home-teacher-common/build/checkDeferredAssets.mjs dist && node scripts/check-page-translations.mjs dist",
    "test": "npm run test:i18n && npm run test:grading-source",
    "test:grading-source": "node --test tests/grading-source.test.cjs tests/answer-undo.test.cjs",
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "build:server": "npm --prefix server run build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:i18n": "node ../home-teacher-common/build/checkTranslations.mjs src ../home-teacher-common/src && node --test tests/localization.test.mjs && tsx --test tests/layers-localization.test.ts"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@types/jspdf": "^1.3.3",
    "fabric": "^5.3.0",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "i18next": "^25.7.4",
    "jspdf": "^3.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.2",
    "react-icons": "^5.5.0",
    "simple-icons": "^15.19.0"
  },
  "devDependencies": {
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/w3c-image-capture": "^1.0.11",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "gh-pages": "^6.3.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-static-copy": "^3.1.4",
    "workbox-window": "^7.3.0"
  }
}
